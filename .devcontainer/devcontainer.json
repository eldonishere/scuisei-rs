{
  "name": "scuisei-rs",
  "build": {
    "dockerfile": "Containerfile"
  },
  "runArgs": ["--name", "scuisei-rs"],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
